#!/usr/bin/env bash
# main/master로의 push와 force push(히스토리 덮어쓰기)를 막는다.
# 설정: git config core.hooksPath .githooks
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "🚫 $remote_ref 로 직접 push할 수 없습니다. 작업 브랜치에 push하고 PR을 여세요."
      blocked=1
      continue ;;
  esac
  [ "$local_sha" = "$ZERO" ] && { echo "🚫 원격 브랜치 삭제($remote_ref)는 hook에서 막습니다. 필요하면 사람이 GitHub에서 지우세요."; blocked=1; continue; }
  [ "$remote_sha" = "$ZERO" ] && continue   # 새 브랜치
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "🚫 $remote_ref 는 force push(히스토리 덮어쓰기)가 됩니다. 막았습니다."
    echo "   개인정보 때문에 히스토리를 정리해야 한다면 사람이 직접 판단해 진행하세요."
    blocked=1
  fi
done
exit "$blocked"
